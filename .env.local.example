NEXT_PUBLIC_SITE_URL=https://example.com

# Public contact email shown on Contact / Privacy pages and footer.
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# The legal/publisher name shown in the footer and JSON-LD.
NEXT_PUBLIC_LEGAL_NAME=GameCodes Hub

# Set to "true" once you have a real AdSense publisher and slot IDs.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Analytics provider: "none" (default) | "vercel" | "plausible"
NEXT_PUBLIC_ANALYTICS=none
# Required when NEXT_PUBLIC_ANALYTICS=plausible
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com
# Override only when self-hosting Plausible
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.io
